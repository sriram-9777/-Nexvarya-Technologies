# Vercel: set this to the public URL of the deployed Express API.
VITE_API_BASE_URL=https://your-api-domain.example.com/api

# Firebase Web App configuration (Vercel environment variables)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Backend only (never expose as VITE_ variables)
MONGODB_URI=
API_MANAGEMENT_KEY=
